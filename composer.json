{
    "name": "synergizeflow/laravel-onboarding",
    "description": "SynergizeFlow core client and onboarding package for Laravel",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "SynergizeFlow\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SynergizeFlow\\Laravel\\SynergizeFlowServiceProvider"
            ]
        }
    }
}
